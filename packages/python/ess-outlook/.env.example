# Microsoft Entra (Azure AD) app registration.
# Both are REQUIRED unless GRAPH_ACCESS_TOKEN below is set -- there is no
# built-in default client ID.
# CLIENT_ID: "Office Desktop Apps" pre-approved on M365 tenant, or your own app registration
CLIENT_ID=
# TENANT_ID: your organization's Azure AD tenant ID
TENANT_ID=

# Optional: bypass the device-code flow with a token pasted from Graph Explorer
# (https://developer.microsoft.com/graph/graph-explorer). Expires in ~1 hour.
# When set, CLIENT_ID and TENANT_ID are not needed.
# GRAPH_ACCESS_TOKEN=

# Optional: prefer browser sign-in over the device-code flow. Requires CLIENT_ID
# to be an app registration listing "http://localhost" as a redirect URI,
# otherwise sign-in fails with AADSTS50011.
# GRAPH_INTERACTIVE_AUTH=1
