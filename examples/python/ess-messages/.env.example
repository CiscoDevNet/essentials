# Outlook (Microsoft Graph). CLIENT_ID and TENANT_ID are required for the
# email source unless GRAPH_ACCESS_TOKEN is set; there is no default client ID.
# CLIENT_ID: Microsoft Entra app registration (e.g., the "Office Desktop Apps" public client)
CLIENT_ID=
# TENANT_ID: your organization's Microsoft Entra (Azure AD) tenant ID
TENANT_ID=
# Optional: a token from https://developer.microsoft.com/graph/graph-explorer,
# for tenants where Conditional Access blocks the device-code flow (~1h TTL)
# GRAPH_ACCESS_TOKEN=
# Optional: browser sign-in instead of device code. Requires CLIENT_ID to be an
# app registration that lists "http://localhost" as a redirect URI.
# GRAPH_INTERACTIVE_AUTH=1

# Webex OAuth integration (from https://developer.webex.com/my-apps)
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=

# Or use a personal access token directly (12-hour TTL)
# https://developer.webex.com/docs/getting-your-personal-access-token
# WEBEX_ACCESS_TOKEN=
